# macOS
.DS_Store

# SwiftPM / Xcode
engine/.build/
engine/Package.resolved.bak
.swiftpm/
DerivedData/
*.xcodeproj
*.xcworkspace

# Agent scratch (worktrees created by parallel runs)
.claude/

# Pinned protoc plugins installed by scripts/gen-proto.sh
.tools/

# Go
go/bin/
go/dist/
*.test
*.out

# Generated IQ fixtures and sidecars (reproducible via `make fixtures`)
fixtures/*.cf32
fixtures/*.cu8
fixtures/*.iq
fixtures/*.json

# Instruments traces from a profiling run (S2, and the allocation checks in
# docs/decisions/S2-throughput.md). Tens of megabytes each, and a fresh one every run.
*.trace/

# Local daemon state / logs
*.sock
*.pid
*.log

# Local RF recordings made while testing (WAV dumps)
rf-captures/

# Scratch: pasted screenshots and other working files, not repo content.
tmp/
evals/runs/

# The app package's build products and the assembled bundle (scripts/bundle-app.sh)
app/.build/
app/dist/
