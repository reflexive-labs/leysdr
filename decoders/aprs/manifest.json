{
  "name": "aprs",
  "version": "0.1.0",
  "description": "APRS over AX.25, Bell 202 AFSK at 1200 baud on 2 m",
  "attribution": "",
  "license": "Apache-2.0",
  "recipe": {
    "frequenciesHz": ["144390000", "144800000"],
    "sampleRate": "0",
    "bandwidthHz": 15000,
    "mode": "NFM",
    "gain": "GAIN_LEAVE"
  },
  "input": {
    "mode": "CONTINUOUS",
    "tap": "TAP_AUDIO"
  },
  "outputs": ["SHAPE_RECORDS", "SHAPE_ENTITIES"],
  "entitySilenceS": 1800,
  "fields": [
    {"name": "symbol", "label": "Symbol", "type": "TEXT", "description": "APRS symbol as its table identifier and code"},
    {"name": "comment", "label": "Comment", "type": "TEXT", "description": "the free text the station sent"},
    {"name": "path", "label": "Path", "type": "TEXT", "description": "digipeater path, used hops marked with a star"},
    {"name": "destination", "label": "Destination", "type": "TEXT", "description": "AX.25 destination address, usually the software's identifier"},
    {"name": "speed_kmh", "label": "Speed", "type": "NUMBER", "unit": "km/h", "description": "speed over ground"},
    {"name": "course_deg", "label": "Course", "type": "NUMBER", "unit": "deg", "description": "course over ground, degrees true"},
    {"name": "temp_c", "label": "Temperature", "type": "NUMBER", "unit": "degC", "description": "air temperature"},
    {"name": "wind_kmh", "label": "Wind", "type": "NUMBER", "unit": "km/h", "description": "sustained wind speed"},
    {"name": "wind_dir_deg", "label": "Wind direction", "type": "NUMBER", "unit": "deg", "description": "wind direction"},
    {"name": "gust_kmh", "label": "Gust", "type": "NUMBER", "unit": "km/h", "description": "peak gust in the last five minutes"},
    {"name": "rain_mm_1h", "label": "Rain, last hour", "type": "NUMBER", "unit": "mm", "description": "rain in the last hour"},
    {"name": "humidity_pct", "label": "Humidity", "type": "NUMBER", "unit": "%", "description": "relative humidity"},
    {"name": "pressure_hpa", "label": "Pressure", "type": "NUMBER", "unit": "hPa", "description": "barometric pressure"},
    {"name": "seq", "label": "Sequence", "type": "TEXT", "description": "telemetry sequence number"},
    {"name": "a1", "label": "Analogue 1", "type": "NUMBER", "description": "telemetry analogue channel 1"},
    {"name": "a2", "label": "Analogue 2", "type": "NUMBER", "description": "telemetry analogue channel 2"},
    {"name": "a3", "label": "Analogue 3", "type": "NUMBER", "description": "telemetry analogue channel 3"},
    {"name": "a4", "label": "Analogue 4", "type": "NUMBER", "description": "telemetry analogue channel 4"},
    {"name": "a5", "label": "Analogue 5", "type": "NUMBER", "description": "telemetry analogue channel 5"},
    {"name": "digital", "label": "Digital bits", "type": "TEXT", "description": "telemetry digital bits, most significant first"},
    {"name": "addressee", "label": "Addressee", "type": "TEXT", "description": "who a message is for"},
    {"name": "text", "label": "Message", "type": "TEXT", "description": "a message's text"},
    {"name": "msg_id", "label": "Message id", "type": "TEXT", "description": "message identifier an ack or reject quotes"},
    {"name": "object_name", "label": "Object name", "type": "TEXT", "description": "name of an object or item"},
    {"name": "alive", "label": "Alive", "type": "FLAG", "description": "whether an object or item is live or killed"}
  ],
  "supportsMultiChannel": false,
  "needsDedicatedCapture": false,
  "statefulPredicatesAvailable": false,
  "display": {
    "title": "APRS",
    "symbol": "antenna.radiowaves.left.and.right",
    "summaries": {
      "position": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
      "object": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
      "item": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
      "weather": "[{temp_c:1} °C][ wind {wind_kmh:0} km/h][ @ {wind_dir_deg:0}°][ gust {gust_kmh:0} km/h][ rain {rain_mm_1h:1} mm/h][ humidity {humidity_pct:0}%][ {pressure_hpa:1} hPa]",
      "message": "→ {addressee}[: {text}][ \\{{msg_id}\\}]",
      "ack": "→ {addressee}: ack {msg_id}",
      "reject": "→ {addressee}: rej {msg_id}",
      "status": "{comment}",
      "telemetry": "T#{seq}[ {a1:3}][ {a2:3}][ {a3:3}][ {a4:3}][ {a5:3}][ {digital}]",
      "other": "{comment}"
    },
    "columns": [
      "symbol",
      "path"
    ],
    "positions": true
  },
  "executable": "leydec-aprs",
  "args": []
}
