{
  "name":  "ais",
  "version":  "0.1.0",
  "aliases":  [
    "vessels"
  ],
  "description":  "AIS marine vessel tracking, GMSK 9600 on the two 25 kHz channels at 161.975 and 162.025 MHz",
  "license":  "Apache-2.0",
  "recipe":  {
    "frequenciesHz":  [
      "161975000",
      "162025000"
    ],
    "bandwidthHz":  25000,
    "mode":  "NFM",
    "gain":  "GAIN_LEAVE"
  },
  "input":  {
    "mode":  "CONTINUOUS",
    "tap":  "TAP_DEMOD",
    "signal":  "SIGNAL_AUDIO"
  },
  "outputs":  [
    "SHAPE_RECORDS",
    "SHAPE_ENTITIES"
  ],
  "entitySilenceS":  600,
  "fields":  [
    {
      "name":  "mmsi",
      "label":  "MMSI",
      "type":  "NUMBER",
      "description":  "Maritime Mobile Service Identity, the vessel's numeric id"
    },
    {
      "name":  "msg_type",
      "label":  "Message type",
      "type":  "NUMBER",
      "description":  "AIS message type number"
    },
    {
      "name":  "sog_kn",
      "label":  "Speed",
      "type":  "NUMBER",
      "unit":  "kn",
      "description":  "speed over ground"
    },
    {
      "name":  "cog_deg",
      "label":  "Course",
      "type":  "NUMBER",
      "unit":  "deg",
      "description":  "course over ground, degrees true"
    },
    {
      "name":  "heading_deg",
      "label":  "Heading",
      "type":  "NUMBER",
      "unit":  "deg",
      "description":  "true heading, degrees"
    },
    {
      "name":  "nav_status",
      "label":  "Navigation status",
      "type":  "NUMBER",
      "description":  "navigational status code (0 under way, 1 at anchor, 5 moored)"
    },
    {
      "name":  "name",
      "label":  "Name",
      "type":  "TEXT",
      "description":  "vessel name"
    },
    {
      "name":  "callsign",
      "label":  "Callsign",
      "type":  "TEXT",
      "description":  "radio callsign"
    },
    {
      "name":  "ship_type",
      "label":  "Ship type",
      "type":  "NUMBER",
      "description":  "ship and cargo type code"
    },
    {
      "name":  "destination",
      "label":  "Destination",
      "type":  "TEXT",
      "description":  "voyage destination"
    }
  ],
  "display": {
    "title": "Vessels",
    "symbol": "ferry",
    "summaries": {
      "position": "{position}[ {sog_kn:1} kn][ @ {cog_deg:0}°]",
      "static": "[{name}][ {callsign}][ → {destination}]",
      "other": "message type {msg_type}"
    },
    "entityName": "{name}",
    "columns": [
      "callsign",
      "sog_kn:1",
      "cog_deg:0",
      "destination"
    ],
    "positions": true
  },
  "executable":  "leydec-ais"
}
