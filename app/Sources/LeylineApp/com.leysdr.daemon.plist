<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.leysdr.daemon</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/leylined</string>
	<key>ProgramArguments</key>
	<array>
		<string>leylined</string>
		<string>--log-file</string>
		<string>~/Library/Logs/Leyline/leylined.log</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.leysdr.app</string>
	</array>
</dict>
</plist>
