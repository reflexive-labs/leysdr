{
  "name": "a station silent for longer than entity_silence_s leaves the table and comes back as a new row",
  "decoder": "aprs",
  "display": {
    "title": "APRS",
    "symbol": "antenna.radiowaves.left.and.right",
    "summaries": {
      "position": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
      "object": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
      "item": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
      "weather": "[{temp_c:1} °C][ wind {wind_kmh:0} km/h][ @ {wind_dir_deg:0}°][ gust {gust_kmh:0} km/h][ rain {rain_mm_1h:1} mm/h][ humidity {humidity_pct:0}%][ {pressure_hpa:1} hPa]",
      "message": "→ {addressee}[: {text}][ \\{{msg_id}\\}]",
      "ack": "→ {addressee}: ack {msg_id}",
      "reject": "→ {addressee}: rej {msg_id}",
      "status": "{comment}",
      "telemetry": "T#{seq}[ {a1:3}][ {a2:3}][ {a3:3}][ {a4:3}][ {a5:3}][ {digital}]",
      "other": "{comment}"
    },
    "columns": ["symbol", "path"]
  },
