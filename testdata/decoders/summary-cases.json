{
  "displays": {
    "aprs": {
      "title": "APRS",
      "symbol": "antenna.radiowaves.left.and.right",
      "summaries": {
        "position": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
        "object": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
        "item": "{position}[ {altitude_m:0} m][ {object_name}][ {symbol}][ {speed_kmh:0} km/h @ {course_deg:0}°][ {comment}]",
        "weather": "[{temp_c:1} °C][ wind {wind_kmh:0} km/h][ @ {wind_dir_deg:0}°][ gust {gust_kmh:0} km/h][ rain {rain_mm_1h:1} mm/h][ humidity {humidity_pct:0}%][ {pressure_hpa:1} hPa]",
        "message": "→ {addressee}[: {text}][ \\{{msg_id}\\}]",
        "ack": "→ {addressee}: ack {msg_id}",
        "reject": "→ {addressee}: rej {msg_id}",
        "status": "{comment}",
        "telemetry": "T#{seq}[ {a1:3}][ {a2:3}][ {a3:3}][ {a4:3}][ {a5:3}][ {digital}]",
        "other": "{comment}"
      },
      "columns": ["symbol", "path"]
    },
    "ais": {
      "title": "Vessels",
      "symbol": "ferry",
      "summaries": {
        "position": "{position}[ {sog_kn:1} kn][ @ {cog_deg:0}°]",
        "static": "[{name}][ {callsign}][ → {destination}]",
        "other": "message type {msg_type}"
      },
      "entity_name": "{name}",
      "columns": ["callsign", "sog_kn:1", "cog_deg:0", "destination"]
    },
    "adsb": {
      "title": "Aircraft",
      "symbol": "airplane",
      "summaries": {
        "identification": "{callsign}[ category {category}]",
        "position": "[{position}][ {altitude_ft:0} ft]",
        "velocity": "[{ground_speed_kn:0} kn][ @ {track_deg:0}°][ {airspeed_kn:0} kn airspeed][ heading {heading_deg:0}°][ {vertical_rate_fpm:0} ft/min]",
        "surveillance": "DF{df}[ {altitude_ft:0} ft][ squawk {squawk}]"
      },
      "entity_name": "[{callsign}]",
      "columns": ["callsign", "altitude_ft:0", "ground_speed_kn:0", "track_deg:0", "squawk"]
    },
    "same": {
      "title": "Weather alerts",
      "symbol": "exclamationmark.triangle",
      "summaries": {
        "alert": "{org} {event_name} ({event})[ for {fips}]"
      }
    },
    "iqstat": {
      "title": "IQ power",
      "symbol": "waveform",
      "summaries": {
        "power": "{power_dbfs:1} dBFS[ over {samples} samples]"
      }
    },
    "speech": {
      "title": "Speech",
      "symbol": "text.bubble",
      "summaries": {
        "": "{text}"
      }
    },
    "rules": {
      "summaries": {
        "literal": "\\{braces\\} and \\[brackets\\] \\{{t}\\} and \\\\",
        "group-then-bracket": "[{t}]\\]",
        "unknown-escape": "\\q{t}",
        "trailing-backslash": "{t}\\",
        "group": "a[ b={b}][ c={c}] d",
        "required": "{missing} x",
        "number": "{n1} {n2} {n3} {n4} {n5} {n6}",
        "rounding": "{a} {b} {c} {d}",
        "precision": "{p:0} {p:3} {p:6} {q:0} {i:0} {big:6}",
        "precision-too-large": "{p:7}",
        "precision-not-a-digit": "{p:x}",
        "precision-empty": "{p:}",
        "integer-limits": "{max} {min}",
        "whitespace": "{t}",
        "position-only": "[{position} ]ok",
        "integer": "{i}",
        "flag": "[{alive}][{killed}]",
        "data": "{bytes}",
        "empty-text": "[{empty} ]{t}",
        "promoted": "{device_id} {kind} {position} {altitude_m} {rssi_dbfs} {snr_db} {label}",
        "promoted-wins": "{kind}",
        "signal": "[{rssi_dbfs} dBFS ]ok",
        "spaces": "  [{missing}]  ",
        "unclosed-name": "{t",
        "nested-group": "[a[{t}]]x",
        "stray-close": "x]",
        "stray-brace": "x}",
        "empty-name": "{}",
        "label": "{label}[ ({device_id})]"
      }
    },
    "default": {
      "summaries": {
        "": "[{device_id}: ]{kind}",
        "own": "own template"
      }
    }
  },
